generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

// Auth and access control
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?
  password  String
  name      String?
  roleId    Int?
  fcmToken  String?  @unique
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  role              Role?          @relation(fields: [roleId], references: [id])
  bookings          Booking[]
  review            Review[]
  notification      Notification[]
  tenantMemberships TenantMember[]
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  rolePermission RolePermission[]
  users          User[]
}

model Permission {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  rolePermission RolePermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

// Tenant boundary
model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TenantMember[]
  property Property?
  bookings Booking[]
  payments Payment[]
}

enum TenantMemberRole {
  OWNER
  STAFF
}

model TenantMember {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  userId    Int
  role      TenantMemberRole
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([tenantId])
  @@index([userId])
}

// Business content
enum PropertyKind {
  HOTEL
  RESTAURANT
}

model Property {
  id          Int            @id @default(autoincrement())
  tenantId    Int            @unique
  kind        PropertyKind
  slug        String         @unique
  name        String
  location    String
  image       String[]
  description String?
  amenities   String[]
  cuisine     String[]
  timeSlots   TimeSlotType[]
  seats       Int?
  menu        Json?
  ratings     Float          @default(0.0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reviews  Review[]
  rooms    Room[]
  bookings Booking[]

  @@index([kind])
  @@index([location])
}

model Room {
  id         Int      @id @default(autoincrement())
  propertyId Int
  price      Float
  image      String[]
  roomType   RoomType @default(SINGLE)
  quantity   Int      @default(1)
  amenities  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([propertyId])
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  rating     Int
  review     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Booking {
  id           Int           @id @default(autoincrement())
  tenantId     Int
  propertyId   Int
  userId       Int
  roomId       Int?
  bookingDate  DateTime
  totalPrice   Float
  roomQuantity Int?
  partySize    Int?
  timeSlot     String?
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room     Room?     @relation(fields: [roomId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  payment  Payment[]

  @@index([roomId, bookingDate])
  @@index([propertyId, bookingDate])
  @@index([tenantId, bookingDate])
  @@index([tenantId, status])
}

model Payment {
  id                    Int           @id @default(autoincrement())
  tenantId              Int
  bookingId             Int
  amount                Float
  currency              String
  status                PaymentStatus
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([bookingId])
}

// Shared enums
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
}

enum TimeSlotType {
  MORNING
  NOON
  AFTERNOON
  EVENING
  NIGHT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}
